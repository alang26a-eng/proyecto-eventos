PORT=8080
NODE_ENV=development
# Usar Atlas o MongoDB con replica set: las reservas usan transacciones.
MONGO_URL=mongodb://127.0.0.1:27017/eventhub?replicaSet=rs0
# Generar un secreto aleatorio de al menos 32 caracteres SOLO en .env.
JWT_SECRET=
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
